# ──────────────────────────────────────────────────────────────────────────
# OpenThena environment configuration
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit your real keys. `.env.local` is gitignored by default.
# ──────────────────────────────────────────────────────────────────────────

# The "brain" — Xiaomi MiMo (OpenAI-compatible API).
# Get a key at https://platform.xiaomimimo.com
MIMO_API_KEY=your-xiaomi-mimo-api-key
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# ── Optional: route everything through a self-hosted LiteLLM proxy ──────────
# If set, the gateway sends requests here instead of straight to the provider.
# See `litellm.config.yaml` and the Self-hosting docs.
# LITELLM_BASE_URL=http://localhost:4000/v1
# LITELLM_API_KEY=sk-litellm-master-key

# ── Optional: override the default assistant persona ────────────────────────
# OPENTHENA_SYSTEM_PROMPT="You are OpenThena, a privacy-first AI assistant."
